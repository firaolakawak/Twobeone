# Used only when pushing the Resend SMTP settings to Supabase.
RESEND_API_KEY=

# Shared secret used by scheduled reminder jobs and the Edge Function.
CRON_SECRET=

# Optional native store destinations used by the landing-page launch hero.
# Set the published Apple listing to enable the App Store download badge.
# Without it, the Apple button opens the iPhone/iPad Home Screen installation guide.
VITE_APP_STORE_URL=
# Optional override; defaults to https://play.google.com/store/apps/details?id=com.twobeone.app.
VITE_GOOGLE_PLAY_URL=
